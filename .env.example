# copy to .env  (chmod 600). Used by docker compose and local node.
# VM2API_* wins; KIN_* is fallback.

VM2API_API_KEY=
VM2API_ADMIN_PASSWORD=
VM2API_DB_SECRET=
# VM2API_ADMIN_USER=admin

PORT=8787
HOST=0.0.0.0
# PUBLIC_BASE_URL=https://example.com

# 可选：codex（GPT）槽。装了就把槽里跑官方 codex CLI，否则退回手写 HTTP 内核。
# KIN_CODEX_BIN=/opt/vm2api/bin/codex
# KIN_CODEX_KERNEL_BIN=/opt/vm2api/bin/kin-codex-kernel
